<div class="rounded-xl bg-white p-6 shadow-md">
    <h2 class="text-2xl font-semibold text-gray-900">Hello, @Name!</h2>
    <button class="mt-4 rounded-lg bg-blue-600 px-4 py-2 text-white hover:bg-blue-700" @onclick="IncrementCount">
        Clicked @count times
    </button>
</div>

@code {
    [Parameter]
    public string Name { get; set; } = "World";

    private int count = 0;

    private void IncrementCount()
    {
        count++;
    }
}
