@{
    ViewData["Title"] = "Inicio";
    var nombre = ViewBag.Nombre as string ?? "Usuario";
}

<div class="container py-4" style="max-width: 640px;">

    <!-- Bienvenida -->
    <div class="rounded-3 overflow-hidden mb-4" style="background:#111827; border:1px solid #1f2937;">
        <div class="text-center text-white py-4 px-3" style="background:#4f46e5;">
            <h1 class="h3 fw-bold mb-1">¡Bienvenido, @nombre!</h1>
            <p class="mb-0" style="color:#c7d2fe;">¿Qué quieres compartir hoy con tu comunidad?</p>
        </div>
        <div class="p-3">
            <textarea class="form-control mb-3 text-white border-0" rows="2"
                      style="background:#1f2937;" placeholder="Escribe tu publicación"></textarea>
            <div class="d-flex justify-content-between gap-2">
                <select class="form-select w-auto text-white border-0" style="background:#1f2937;">
                    <option selected>Elige una categoría</option>
                    <option>Queja</option>
                    <option>Sugerencia</option>
                    <option>Evento</option>
                    <option>Aviso</option>
                </select>
                <button type="button" class="btn text-white" style="background:#4f46e5;">Publicar</button>
            </div>
        </div>
    </div>

    <!-- Publicación: Sugerencia -->
    <div class="rounded-3 p-3 mb-3" style="background:#111827; border:1px solid #1f2937;">
        <div class="d-flex justify-content-between align-items-center mb-2">
            <div>
                <div class="fw-semibold text-white">María Ramírez</div>
                <small style="color:#9ca3af;">Hace 2 h</small>
            </div>
            <span class="badge bg-warning-subtle text-warning-emphasis">Sugerencia</span>
        </div>
        <p class="mb-3" style="color:#d1d5db;">Propongo poner más enchufes en la cafetería para poder cargar las laptops mientras estudiamos.</p>
        <div class="d-flex gap-2 pt-2" style="border-top:1px solid #1f2937;">
            <button type="button" class="btn btn-sm text-white" style="background:#1f2937;">♥ 32</button>
            <button type="button" class="btn btn-sm text-white" style="background:#1f2937;">Comentarios 5</button>
        </div>
    </div>

    <!-- Publicación: Evento -->
    <div class="rounded-3 p-3 mb-3" style="background:#111827; border:1px solid #1f2937;">
        <div class="d-flex justify-content-between align-items-center mb-2">
            <div>
                <div class="fw-semibold text-white">Jorge López</div>
                <small style="color:#9ca3af;">Ayer</small>
            </div>
            <span class="badge bg-success-subtle text-success-emphasis">Evento</span>
        </div>
        <p class="mb-3" style="color:#d1d5db;">El viernes hay feria de proyectos de software a las 10:00 en el auditorio. ¡Están invitados!</p>
        <div class="d-flex gap-2 pt-2" style="border-top:1px solid #1f2937;">
            <button type="button" class="btn btn-sm text-white" style="background:#1f2937;">♥ 18</button>
            <button type="button" class="btn btn-sm text-white" style="background:#1f2937;">Comentarios 7</button>
        </div>
    </div>

    <!-- Publicación: Queja -->
    <div class="rounded-3 p-3 mb-3" style="background:#111827; border:1px solid #1f2937;">
        <div class="d-flex justify-content-between align-items-center mb-2">
            <div>
                <div class="fw-semibold text-white">Ana Sánchez</div>
                <small style="color:#9ca3af;">Hace 3 días</small>
            </div>
            <span class="badge bg-danger-subtle text-danger-emphasis">Queja</span>
        </div>
        <p class="mb-3" style="color:#d1d5db;">El aire acondicionado del aula B-204 lleva una semana sin funcionar.</p>
        <div class="d-flex gap-2 pt-2" style="border-top:1px solid #1f2937;">
            <button type="button" class="btn btn-sm text-white" style="background:#1f2937;">♥ 21</button>
            <button type="button" class="btn btn-sm text-white" style="background:#1f2937;">Comentarios 3</button>
        </div>
    </div>

    <!-- Publicación: Aviso -->
    <div class="rounded-3 p-3" style="background:#111827; border:1px solid #1f2937;">
        <div class="d-flex justify-content-between align-items-center mb-2">
            <div>
                <div class="fw-semibold text-white">Coordinación</div>
                <small style="color:#9ca3af;">Hace 4 días</small>
            </div>
            <span class="badge bg-primary-subtle text-primary-emphasis">Aviso</span>
        </div>
        <p class="mb-3" style="color:#d1d5db;">Durante exámenes finales la biblioteca abrirá de 7:00 a 22:00 h.</p>
        <div class="d-flex gap-2 pt-2" style="border-top:1px solid #1f2937;">
            <button type="button" class="btn btn-sm text-white" style="background:#1f2937;">♥ 12</button>
            <button type="button" class="btn btn-sm text-white" style="background:#1f2937;">Comentarios 1</button>
        </div>
    </div>

</div>
