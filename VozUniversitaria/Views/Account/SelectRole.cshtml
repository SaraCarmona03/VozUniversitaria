@{
    ViewData["Title"] = "Select Role";
    Layout = null;
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - VozUniversitaria</title>
    <style>
        * { box-sizing: border-box; }
        body {
            margin: 0; min-height: 100vh; display: flex; align-items: center; justify-content: center;
            background: #0b1120; color: #e5e7eb; padding: 24px;
            font-family: "Segoe UI", system-ui, -apple-system, Roboto, Arial, sans-serif;
        }
        .card-role { width: 100%; max-width: 560px; background: #111827; border: 1px solid #1f2937; border-radius: 16px; overflow: hidden; }
        .header { background: linear-gradient(135deg, #4f46e5, #6366f1); padding: 28px 24px; text-align: center; }
        .header h1 { margin: 0; font-size: 24px; font-weight: 700; color: #fff; }
        .header p { margin: 6px 0 0; font-size: 14px; color: #c7d2fe; }
        .body { padding: 24px; }
        .roles { display: grid; grid-template-columns: 1fr 1fr; gap: 12px; }
        @@media (max-width: 480px) { .roles { grid-template-columns: 1fr; } }
        .role {
            display: block; text-decoration: none; text-align: center;
            background: #1f2937; border: 1px solid #374151; border-radius: 12px; padding: 22px 12px;
            transition: border-color .15s, transform .15s, background .15s;
        }
        .role:hover { border-color: #4f46e5; background: #232f45; transform: translateY(-2px); }
        .role:focus-visible { outline: none; border-color: #4f46e5; box-shadow: 0 0 0 3px rgba(79,70,229,.25); }
        .icon {
            width: 52px; height: 52px; margin: 0 auto 12px; border-radius: 50%;
            background: rgba(79,70,229,.18); display: flex; align-items: center; justify-content: center; font-size: 24px;
        }
        .role-name { color: #fff; font-weight: 600; font-size: 16px; }
        .role-desc { color: #9ca3af; font-size: 13px; margin-top: 4px; }
        .footer { border-top: 1px solid #1f2937; margin-top: 22px; padding-top: 18px; text-align: center; font-size: 14px; color: #9ca3af; }
        .footer a { color: #818cf8; text-decoration: none; }
        .footer a:hover { text-decoration: underline; }
    </style>
</head>
<body>
    <div class="card-role">
        <div class="header">
            <h1>Who are you?</h1>
            <p>Select your role to continue with your registration. Administrator access is assigned separately.</p>
        </div>

        <div class="body">
            <div class="roles">
                <a asp-action="Register" asp-route-role="Student" class="role">
                    <div class="icon">🎓</div>
                    <div class="role-name">Student</div>
                    <div class="role-desc">Share ideas and join events</div>
                </a>
                <a asp-action="Register" asp-route-role="Teacher" class="role">
                    <div class="icon">👨‍🏫</div>
                    <div class="role-name">Teacher</div>
                    <div class="role-desc">Post notices for your classes</div>
                </a>
                <a asp-action="Register" asp-route-role="Staff" class="role">
                    <div class="icon">🧰</div>
                    <div class="role-name">Staff</div>
                    <div class="role-desc">Support the campus community</div>
                </a>
            </div>

            <div class="footer">
                Already have an account? <a asp-action="Login">Sign in</a>
            </div>
        </div>
    </div>
</body>
</html>
