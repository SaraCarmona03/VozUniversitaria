@model VozUniversitaria.ViewModels.RegisterViewModel
@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers
@{
    ViewData["Title"] = "Register";
    Layout = null;
}
<!DOCTYPE html>
<html lang="en" class="dark">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Voz Universitaria</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet">
    <style>
        body { font-family: 'Inter', sans-serif; background-color: #080c14; }
    </style>
</head>
<body class="text-gray-100 min-h-screen flex items-center justify-center p-4">
    <div class="w-full max-w-md bg-[#111726] rounded-xl shadow-2xl overflow-hidden border border-[#2a3449]">
        <!-- Header Banner -->
        <div class="bg-indigo-600 px-6 py-8 text-center">
            <h1 class="text-3xl font-bold text-white tracking-wide">Voz Universitaria</h1>
            <p class="text-indigo-200 mt-2 text-sm">Create your new account</p>
        </div>

        <div class="p-6 sm:p-8">
            <form asp-controller="Account" asp-action="Register" method="post" class="space-y-4">
                <div asp-validation-summary="ModelOnly" class="text-red-400 text-sm bg-red-900/30 p-3 rounded-lg border border-red-800/50"></div>

                <div>
                    <label asp-for="Name" class="block text-xs font-semibold text-gray-400 uppercase tracking-wider mb-1"></label>
                    <input asp-for="Name" class="w-full px-3 py-2 bg-[#1a2234] border border-[#2a3449] rounded-lg text-white placeholder-gray-400 focus:outline-none focus:ring-2 focus:ring-indigo-500 focus:border-transparent text-sm" placeholder="John" />
                    <span asp-validation-for="Name" class="text-red-400 text-xs mt-1 block"></span>
                </div>
<form asp-action="Register" method="post">
    <input type="hidden" asp-for="Role" value="@ViewData["Role"]" />
    <div asp-validation-summary="ModelOnly" class="text-danger"></div>

                <div>
                    <label asp-for="LastName" class="block text-xs font-semibold text-gray-400 uppercase tracking-wider mb-1"></label>
                    <input asp-for="LastName" class="w-full px-3 py-2 bg-[#1a2234] border border-[#2a3449] rounded-lg text-white placeholder-gray-400 focus:outline-none focus:ring-2 focus:ring-indigo-500 focus:border-transparent text-sm" placeholder="Doe" />
                    <span asp-validation-for="LastName" class="text-red-400 text-xs mt-1 block"></span>
                </div>

                <div>
                    <label asp-for="CaseNumber" class="block text-xs font-semibold text-gray-400 uppercase tracking-wider mb-1"></label>
                    <input asp-for="CaseNumber" class="w-full px-3 py-2 bg-[#1a2234] border border-[#2a3449] rounded-lg text-white placeholder-gray-400 focus:outline-none focus:ring-2 focus:ring-indigo-500 focus:border-transparent text-sm" placeholder="123456" />
                    <span asp-validation-for="CaseNumber" class="text-red-400 text-xs mt-1 block"></span>
                </div>

                <div>
                    <label asp-for="Email" class="block text-xs font-semibold text-gray-400 uppercase tracking-wider mb-1"></label>
                    <input asp-for="Email" type="email" class="w-full px-3 py-2 bg-[#1a2234] border border-[#2a3449] rounded-lg text-white placeholder-gray-400 focus:outline-none focus:ring-2 focus:ring-indigo-500 focus:border-transparent text-sm" placeholder="name@example.com" />
                    <span asp-validation-for="Email" class="text-red-400 text-xs mt-1 block"></span>
                </div>
    <div class="form-group">
        <label asp-for="CaseNumber">
         @(ViewData["Role"]?.ToString() == "Student" ? "Matrícula" : "Número de empleado")
        </label>
        <input asp-for="CaseNumber" class="form-control" />
        <span asp-validation-for="CaseNumber" class="text-danger"></span>
    </div>

                <div>
                    <label asp-for="Password" class="block text-xs font-semibold text-gray-400 uppercase tracking-wider mb-1"></label>
                    <input asp-for="Password" type="password" class="w-full px-3 py-2 bg-[#1a2234] border border-[#2a3449] rounded-lg text-white placeholder-gray-400 focus:outline-none focus:ring-2 focus:ring-indigo-500 focus:border-transparent text-sm" placeholder="••••••••" />
                    <span asp-validation-for="Password" class="text-red-400 text-xs mt-1 block"></span>
                </div>

                <div>
                    <label asp-for="ConfirmPassword" class="block text-xs font-semibold text-gray-400 uppercase tracking-wider mb-1"></label>
                    <input asp-for="ConfirmPassword" type="password" class="w-full px-3 py-2 bg-[#1a2234] border border-[#2a3449] rounded-lg text-white placeholder-gray-400 focus:outline-none focus:ring-2 focus:ring-indigo-500 focus:border-transparent text-sm" placeholder="••••••••" />
                    <span asp-validation-for="ConfirmPassword" class="text-red-400 text-xs mt-1 block"></span>
                </div>

                <button type="submit" class="w-full mt-2 py-2.5 px-4 bg-indigo-600 hover:bg-indigo-500 focus:ring-2 focus:ring-indigo-400 text-white font-medium text-sm rounded-lg shadow transition duration-150 ease-in-out">
                    Register
                </button>
            </form>

            <div class="mt-6 text-center border-t border-[#2a3449] pt-4">
                <p class="text-sm text-gray-400">
                    Already have an account? 
                    <a asp-controller="Account" asp-action="Login" class="font-medium text-indigo-400 hover:text-indigo-300 hover:underline transition duration-150 ease-in-out">Login here</a>
                </p>
            </div>
        </div>
    </div>
</body>
</html>
